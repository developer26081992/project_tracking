# Neon pooled connection for application queries. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooler) connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require"

# Clerk Dashboard > API keys. Only the publishable key is safe for the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Clerk webhook endpoint signing secret (whsec_...), not the Clerk API secret.
CLERK_WEB_HOOK_SECRET=""
# Optional compatibility alias; leave empty when CLERK_WEB_HOOK_SECRET is set.
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/dashboard"

# Optional: use real Clerk IDs when seeding so those users can access demo projects.
# Defaults: user_demo_owner and user_demo_developer. Use only in a demo database.
SEED_OWNER_CLERK_ID=""
SEED_MEMBER_CLERK_ID=""
